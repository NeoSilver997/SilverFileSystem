# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=silverfilesystem

# JWT Authentication Configuration
# IMPORTANT: Set this to a secure random value in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-here

# Admin User Configuration
# Set these to create the default admin user with specific credentials
# If not set, a random password will be generated and displayed on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here

# Session Secret for OAuth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secure-session-secret-here

# Google OAuth Configuration (optional)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Environment
NODE_ENV=development
FRONTEND_URL=http://localhost:4000

# VLM — Strata OpenAI-compatible (Describe / Ask). Default: local Strata vision on :8080
# Start: C:\AI_Server\Coding\Strata\run-iq2_xs-V-vision*.bat (or strata launch with --vision)
LMSTUDIO_URL=http://127.0.0.1:8080
VLM_URL=http://127.0.0.1:8080
VLM_MODEL=qwen3.8-flash-next-iq2_xs-V-vision-128k-kv64k
VLM_TIMEOUT=180000
# Prefer key file (do not commit the key). Or set VLM_API_KEY=...
VLM_API_KEY_FILE=C:\AI_Server\Coding\Strata\cloudflare\strata-api-key.txt
# openai (Strata/OpenAI image_url) | lmstudio (legacy images:[] payload)
VLM_IMAGE_MODE=openai
# Prefer thumbnail_cache JPEG for Describe/Ask (UI can override). Default true in API when omit.
VLM_USE_THUMBNAIL=true
VLM_MAX_WIDTH=384
VLM_JPEG_QUALITY=55

# EmbeddingGemma 2 via llama-server (semantic image index)
# Start example (Vulkan GPU):
#   llama-server -m embeddinggemma-2-Q8_0.gguf --mmproj mmproj-embeddinggemma-2-Q8_0.gguf --embeddings --port 12333
EMBEDDING_URL=http://127.0.0.1:12333
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_TIMEOUT=120000
EMBEDDING_DIMS=768
PHOTO_OUTPUT_DIR=

# Coarse embedding taxonomy (cosine vs text prototypes)
EMBED_CLASSIFY_MIN_SCORE=0.25
